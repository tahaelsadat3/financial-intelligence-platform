*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Database & Storage (قواعد البيانات المحلية والملفات المؤقتة)
*.sqlite3
*.db
uploads/
temp/

# IDE & OS Settings (إعدادات بيئة العمل الخاصة بالجهاز)
.vscode/
.idea/
.DS_Store
Thumbs.db
